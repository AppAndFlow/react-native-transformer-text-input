{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "react-native-transformer-text-input": ["./src/index"],
      "react-native-transformer-text-input/formatters/phone-number": ["./src/formatters/phone-number"],
      "react-native-transformer-text-input/formatters/pattern": ["./src/formatters/pattern"],
      "react-native-transformer-text-input/formatters/currency": ["./src/formatters/currency"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": ["react-native-strict-api"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  }
}
